# Deep Tree Echo — Level 5 Autonomy Configuration
# Copy to .env and fill in your values

# ─── Lucy Inference Server ─────────────────────────────────────────
LUCY_PORT=8081
LUCY_CTX_SIZE=32768
LUCY_THREADS=4
LUCY_BATCH_SIZE=512
LUCY_MAX_PREDICT=2048
LUCY_PARALLEL=1

# ─── API LLM Fallbacks (optional) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=

# ─── DeltaChat ─────────────────────────────────────────────────────
DELTACHAT_EMAIL=
DELTACHAT_PASSWORD=

# ─── Orchestrator ──────────────────────────────────────────────────
ORCHESTRATOR_PORT=3000
ECHOBEATS_INTERVAL_MS=1000
LOG_LEVEL=info
